# Bot
BOT_NAME=FriendsBot
PREFIX=!
COOLDOWN_MS=1500

# WhatsApp
# Keep false until you are ready to link the account.
WHATSAPP_ENABLED=false

# Optional: restrict replies to one WhatsApp group JID.
# Leave empty during first setup; the bot will print group IDs when connected.
ALLOWED_GROUP_ID=

# For mobile setup, put your WhatsApp number here with country code and digits only.
# Example format: 919876543210 (do not include +, spaces, or dashes).
PAIRING_PHONE_NUMBER=

# Optional future AI configuration
AI_API_KEY=
AI_MODEL=
